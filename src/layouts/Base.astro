---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "works" | "about" | "contact";
}
const {
  title = "佐藤 颯太郎 | AIエンジニア・マーケター ポートフォリオ",
  description = "AIエンジニア兼マーケター 佐藤颯太郎のポートフォリオ。LLM / RAG を活用したアプリ開発と、AIを用いたマーケティング施策の実績を、課題・工夫・成果とともに掲載しています。",
  active = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL; // 例: "/portfolio/"
const nav = [
  { key: "home", label: "Home", href: base },
  { key: "works", label: "Works", href: `${base}works/` },
  { key: "about", label: "About", href: `${base}about/` },
  { key: "contact", label: "Contact", href: `${base}contact/` },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="佐藤 颯太郎" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div id="progress-bar" aria-hidden="true"></div>

    <!-- ===== Navigation ===== -->
    <header class="sticky top-0 z-50 border-b border-line bg-white/85 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3.5" aria-label="メインナビゲーション">
        <a href={base} class="font-display text-base font-extrabold tracking-tight text-ink">
          佐藤颯太郎
        </a>

        <div class="hidden items-center gap-7 text-sm md:flex">
          {
            nav.map((n) => (
              <a href={n.href} class="nav-link" aria-current={active === n.key ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </div>

        <div class="flex items-center gap-2">
          <a href={`${base}contact/`} class="hidden rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark sm:inline-block">お問い合わせ</a>
          <button id="menu-button" type="button" aria-label="メニュー" aria-expanded="false" aria-controls="mobile-menu" class="flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink md:hidden">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="hidden border-t border-line bg-white md:hidden">
        <div class="mx-auto flex max-w-5xl flex-col px-5 py-2 text-sm">
          {nav.map((n) => <a href={n.href} class="py-2 text-body">{n.label}</a>)}
          <a href={`${base}contact/`} class="py-2 font-semibold text-brand">お問い合わせ</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ===== Footer ===== -->
    <footer class="border-t border-line bg-soft">
      <div class="mx-auto max-w-5xl px-5 py-10">
        <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
          <div>
            <p class="font-display text-base font-extrabold tracking-tight text-ink">佐藤颯太郎</p>
            <p class="mt-1 text-sm text-muted">AIエンジニア / マーケター ・ 個人事業主</p>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {nav.map((n) => <a href={n.href} class="text-muted transition hover:text-ink">{n.label}</a>)}
            <a href="https://github.com/sotaro0000" target="_blank" rel="noopener" class="text-muted transition hover:text-ink">GitHub ↗</a>
          </div>
        </div>
        <p class="mt-8 font-mono text-[11px] text-muted">© 2026 Sotaro Sato — built with Astro &amp; Tailwind CSS</p>
      </div>
    </footer>

    <button id="back-to-top" type="button" aria-label="ページ上部へ戻る" class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-white shadow-lg transition hover:bg-brand">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M6 11l6-6 6 6" /></svg>
    </button>

    <script>
      // スクロール連動の演出（reveal / progress / back-to-top / mobile menu）
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      const bar = document.getElementById("progress-bar");
      const toTop = document.getElementById("back-to-top");
      const onScroll = () => {
        const doc = document.documentElement;
        const ratio = doc.scrollTop / (doc.scrollHeight - doc.clientHeight || 1);
        if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
        if (toTop) toTop.classList.toggle("show", doc.scrollTop > 600);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      toTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" }));

      const menuButton = document.getElementById("menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      menuButton?.addEventListener("click", () => {
        const open = mobileMenu?.classList.contains("hidden");
        mobileMenu?.classList.toggle("hidden", !open);
        menuButton.setAttribute("aria-expanded", String(!!open));
      });
    </script>
  </body>
</html>
