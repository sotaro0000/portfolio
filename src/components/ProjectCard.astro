---
import type { Project } from "../data/projects";
interface Props { project: Project; }
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL;
const img = p.image ? `${base}${p.image}` : null;
---

{/* ===== Featured（主役）===== */}
{p.featured ? (
  <article class="reveal overflow-hidden rounded-lg border border-line bg-white">
    <div class="flex flex-col gap-1 bg-ink p-6 text-white sm:flex-row sm:items-center sm:justify-between">
      <div>
        <span class="kicker text-slate-400">{p.kind} ・ {p.badges.join(" / ")}</span>
        <h3 class="mt-2 font-display text-2xl font-bold">{p.title}</h3>
        <p class="text-sm text-slate-400">{p.subtitle}</p>
      </div>
      <div class="mt-4 flex gap-2 sm:mt-0">
        {p.demoUrl && <a href={p.demoUrl} target="_blank" rel="noopener" class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:bg-slate-100">デモを開く ↗</a>}
        {p.repoUrl && <a href={p.repoUrl} target="_blank" rel="noopener" class="rounded-md border border-white/25 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">GitHub ↗</a>}
      </div>
    </div>

    {img && (
      <div class="border-b border-line bg-soft p-4 sm:p-8">
        <div class="mx-auto max-w-3xl overflow-hidden rounded-lg border border-line bg-white shadow-sm">
          <div class="browser-bar flex items-center gap-2 border-b border-line bg-soft px-4 py-2.5">
            <span class="ml-auto rounded bg-white px-3 py-0.5 font-mono text-[10px] text-muted">{p.imageHost}</span>
          </div>
          <img src={img} alt={`${p.title} の画面`} class="block w-full" loading="lazy" />
        </div>
      </div>
    )}

    <div class="grid gap-8 p-6 sm:p-8 md:grid-cols-2">
      <div class="space-y-4 text-sm leading-relaxed">
        <div><p class="mb-1 text-[11px] font-bold uppercase tracking-wider text-rose-600">課題</p><p class="text-body">{p.problem}</p></div>
        <div><p class="mb-1 text-[11px] font-bold uppercase tracking-wider text-amber-600">アプローチ</p><p class="text-body">{p.approach}</p></div>
        <div><p class="mb-1 text-[11px] font-bold uppercase tracking-wider text-emerald-600">成果 / 工夫</p><p class="text-body">{p.result}</p></div>
      </div>
      <div class="space-y-4">
        {p.features && (
          <div>
            <p class="kicker mb-2 text-muted">主な機能</p>
            <ul class="space-y-1 text-xs text-body">{p.features.map((f) => <li>・{f}</li>)}</ul>
          </div>
        )}
        <div>
          <p class="kicker mb-2 text-muted">Tech Stack</p>
          <div class="flex flex-wrap gap-1.5">{p.stack.map((s) => <span class="rounded bg-soft px-2 py-1 font-mono text-[11px] text-body">{s}</span>)}</div>
        </div>
        <p class="text-xs text-muted">役割：{p.role}</p>
      </div>
    </div>
  </article>
) : (
  /* ===== 通常カード ===== */
  <article class="reveal card-hover rounded-lg border border-line bg-white p-6 sm:p-8">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="rounded bg-soft px-2 py-0.5 font-mono text-[11px] text-muted">{p.kind}</span>
      {p.badges.map((b) => <span class="rounded bg-brand-soft px-2 py-0.5 font-mono text-[11px] text-brand">{b}</span>)}
    </div>
    <h3 class="font-display text-xl font-bold text-ink">{p.title}</h3>
    <p class="mt-1 text-sm text-muted">{p.subtitle}</p>

    {img && (
      <div class="mt-5 overflow-hidden rounded-lg border border-line bg-white shadow-sm">
        <div class="browser-bar flex items-center gap-2 border-b border-line bg-soft px-4 py-2.5">
          <span class="ml-auto rounded bg-white px-3 py-0.5 font-mono text-[10px] text-muted">{p.imageHost}</span>
        </div>
        <img src={img} alt={`${p.title} の画面`} class="block w-full" loading="lazy" />
      </div>
    )}

    <div class="mt-5 grid gap-8 md:grid-cols-2">
      <div class="space-y-3 text-sm leading-relaxed">
        <p><span class="text-[11px] font-bold uppercase tracking-wider text-rose-600">課題：</span><span class="text-body">{p.problem}</span></p>
        <p><span class="text-[11px] font-bold uppercase tracking-wider text-amber-600">アプローチ：</span><span class="text-body">{p.approach}</span></p>
        <p><span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600">成果：</span><span class="text-body">{p.result}</span></p>
        <p class="text-xs text-muted">役割：{p.role}</p>
      </div>
      <div class="space-y-4">
        {p.features && (
          <div>
            <p class="kicker mb-2 text-muted">主な機能</p>
            <ul class="space-y-1 text-xs text-body">{p.features.map((f) => <li>・{f}</li>)}</ul>
          </div>
        )}
        <div>
          <p class="kicker mb-2 text-muted">Tech Stack</p>
          <div class="flex flex-wrap gap-1.5">{p.stack.map((s) => <span class="rounded bg-soft px-2 py-1 font-mono text-[11px] text-body">{s}</span>)}</div>
        </div>
        {p.demoUrl && <a href={p.demoUrl} target="_blank" rel="noopener" class="inline-block text-sm font-semibold text-brand underline-offset-4 hover:underline">{p.demoLabel ?? "サイトを開く"} ↗</a>}
      </div>
    </div>
  </article>
)}
