---
import Base from "../layouts/Base.astro";
---

<Base active="contact" title="Contact | 佐藤 颯太郎 ポートフォリオ" description="AIを活用したアプリ開発・RAG構築・AIマーケティングのご相談。業務委託を受付中です。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-3xl px-5 py-24 text-center">
      <span class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>現在、業務委託のご相談を受付中です
      </span>
      <p class="reveal kicker mb-2">Contact</p>
      <h1 class="reveal mb-4 font-display text-3xl font-bold text-ink sm:text-4xl">一緒に、AIで成果をつくりませんか？</h1>
      <p class="reveal mx-auto mb-10 max-w-xl text-sm leading-relaxed text-body">
        AI を活用したアプリ開発・PoC、RAG システム構築、AIエージェント、AIマーケティング施策（SEO / AIO）など、
        お仕事のご相談を承っています。まずはお気軽にメッセージください。
      </p>

      <div class="reveal mx-auto max-w-md space-y-3 text-left">
        <a href="mailto:sotaro.gt@gmail.com" class="card-hover flex items-center gap-4 rounded-lg border border-line bg-white p-5">
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-brand-soft text-brand">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          </span>
          <span>
            <span class="block font-mono text-[11px] uppercase tracking-wider text-muted">Email</span>
            <span class="font-display font-semibold text-ink">sotaro.gt@gmail.com</span>
          </span>
        </a>
        <a href="https://github.com/sotaro0000" target="_blank" rel="noopener" class="card-hover flex items-center gap-4 rounded-lg border border-line bg-white p-5">
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-soft text-ink">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 8.8 21.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z" /></svg>
          </span>
          <span>
            <span class="block font-mono text-[11px] uppercase tracking-wider text-muted">GitHub</span>
            <span class="font-display font-semibold text-ink">github.com/sotaro0000</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>
