---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const base = import.meta.env.BASE_URL;

const writing = [
  { label: "公開中アプリ", title: "AIO Lens", desc: "生成AIへの引用されやすさを診断する AIO ツール。", href: "https://aio-lens.vercel.app" },
  { label: "公開中アプリ", title: "Tech Doc Assistant", desc: "GPT-4 × RAG の AIドキュメント管理アプリ。", href: "https://tech-doc-assistant.vercel.app" },
  { label: "公開中アプリ", title: "AI Research Agent", desc: "計画→検索→合成を自動実行するAIエージェント。", href: "https://sotaro0000-research-agent.vercel.app" },
  { label: "GitHub", title: "ソースコード公開", desc: "個人開発のコードを README 付きで公開。", href: "https://github.com/sotaro0000" },
];
---

<Base active="works" title="Works | 佐藤 颯太郎 ポートフォリオ" description="AIO Lens・Diagram Studio・Tech Doc Assistant・AI Research Agent などの制作物を、課題・アプローチ・成果とともに掲載。">
  {/* 見出し */}
  <section>
    <div class="mx-auto max-w-5xl px-5 pb-8 pt-16 sm:pt-20">
      <p class="reveal kicker mb-2">Works</p>
      <h1 class="reveal font-display text-3xl font-bold text-ink sm:text-4xl">制作物・プロジェクト</h1>
      <p class="reveal mt-3 max-w-2xl text-sm leading-relaxed text-body">
        各カードから詳細（課題 → アプローチ → 成果）をご覧いただけます。個人開発はすべて公開中で、実際に触って確認できます。
      </p>

      {/* フィルタータブ */}
      <div class="reveal mt-7 inline-flex gap-1 rounded-full border border-line bg-white p-1" role="tablist">
        {[
          { k: "all", label: "すべて" },
          { k: "個人開発", label: "個人開発" },
          { k: "業務", label: "業務" },
        ].map((t, i) => (
          <button
            type="button"
            data-filter={t.k}
            class:list={["filter-btn rounded-full px-4 py-1.5 text-sm font-medium transition", i === 0 ? "bg-ink text-white" : "text-muted hover:text-ink"]}
          >
            {t.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* カードグリッド */}
  <section>
    <div class="mx-auto max-w-5xl px-5 pb-12">
      <div class="grid gap-5 sm:grid-cols-2">
        {projects.map((p, i) => (
          <a
            href={`${base}works/${p.slug}/`}
            data-kind={p.kind}
            class={`work-card reveal card-hover flex flex-col overflow-hidden rounded-xl border border-line bg-white delay-${i % 3}`}
          >
            {p.image ? (
              <div class="border-b border-line bg-soft">
                <img src={`${base}${p.image}?v=4`} alt={`${p.title} の画面`} class="block w-full" loading="lazy" />
              </div>
            ) : (
              <div class="flex h-40 items-center justify-center border-b border-line bg-gradient-to-br from-slate-900 to-slate-700">
                <span class="font-display text-lg font-bold text-white/90">{p.title.split("（")[0].split(" —")[0]}</span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded bg-soft px-2 py-0.5 font-mono text-[10px] text-muted">{p.kind}</span>
                {p.badges.slice(0, 1).map((b) => <span class="rounded bg-brand-soft px-2 py-0.5 font-mono text-[10px] text-brand">{b}</span>)}
              </div>
              <h2 class="font-display text-lg font-bold text-ink">{p.title}</h2>
              <p class="mt-1 text-sm text-muted">{p.subtitle}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {p.stack.slice(0, 4).map((s) => <span class="rounded bg-soft px-2 py-1 font-mono text-[10px] text-body">{s}</span>)}
              </div>
              <span class="mt-4 inline-block text-sm font-semibold text-brand">詳細を見る →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 発信 */}
  <section class="border-t border-line bg-soft">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <p class="reveal kicker mb-2">Writing / Output</p>
      <h2 class="reveal mb-8 font-display text-2xl font-bold text-ink">発信・アウトプット</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {writing.map((w, i) => (
          <a href={w.href} target="_blank" rel="noopener" class={`reveal card-hover rounded-lg border border-line bg-white p-5 delay-${i % 3}`}>
            <p class="kicker">{w.label}</p>
            <p class="mt-2 font-display font-semibold text-ink">{w.title}</p>
            <p class="mt-1 text-xs text-muted">{w.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-5xl px-5 py-12 text-center">
      <a href={`${base}contact/`} class="inline-block rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">お仕事のご相談はこちら →</a>
    </div>
  </section>

  <script>
    // Works フィルタータブ（個人開発 / 業務 / すべて）
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".work-card");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle("bg-ink", on);
          b.classList.toggle("text-white", on);
          b.classList.toggle("text-muted", !on);
        });
        cards.forEach((c) => {
          const show = f === "all" || c.dataset.kind === f;
          c.style.display = show ? "" : "none";
        });
      });
    });
  </script>
</Base>
