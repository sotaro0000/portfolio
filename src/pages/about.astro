---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;

const strengths = [
  { title: "課題ドリブン", desc: "データ分析で課題を発見し、技術で解決まで導く。「作ること」より「成果が出ること」を起点に設計します。", icon: '<circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="3.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" />' },
  { title: "細やかな情報連携", desc: "進捗や変更を迅速・詳細に共有し、チーム全員が同じ視界で進められる状態をつくる。タスク分解で抜け漏れを防ぎます。", icon: '<circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M8.3 10.9 15.7 7.1M8.3 13.1l7.4 3.8" />' },
  { title: "学び続ける", desc: "セミナー・ハッカソン参加や資格取得で最新技術を追い、作ったものを公開・発信して定着させています。", icon: '<path d="M12 6.5C10.3 5.2 7.7 4.7 5 4.7c-.7 0-1.3 0-2 .2v13c.7-.2 1.3-.2 2-.2 2.7 0 5.3.5 7 1.8 1.7-1.3 4.3-1.8 7-1.8.7 0 1.3 0 2 .2v-13c-.7-.2-1.3-.2-2-.2-2.7 0-5.3.5-7 1.8z" /><path d="M12 6.5v13" />' },
];

const skills = [
  { cat: "AI / LLM", items: ["RAG（検索拡張生成）", "LangChain / LangGraph", "OpenAI / Anthropic / Gemini API", "Dify / プロンプト設計", "Vector DB（Pinecone / Weaviate）"] },
  { cat: "Backend", items: ["Python / FastAPI", "Node.js (Route Handlers)", "PostgreSQL / MySQL", "REST API 設計", "C（組み込み）"] },
  { cat: "Frontend", items: ["TypeScript / JavaScript", "Next.js / React / Astro", "Tailwind CSS", "HTML / CSS"] },
  { cat: "Infra / Marketing", items: ["Docker / AWS / Linux", "GitHub Actions (CI/CD)", "SEO / AIO（AI最適化）", "MAツール / データ分析"] },
];

const career = [
  { period: "2026.05", title: "リブランディング株式会社（業務委託） ／ AIプランナー・開発・運用", desc: "生成AIを活用した Web サイト制作・口コミ施策、データ分析と予測モデル構築、MAツールの AI 強化。", on: true },
  { period: "2025.10 – 2026.04", title: "株式会社FERNET ／ Web・AIエンジニア", desc: "社内システム改修（チームリーダー）、設計書→打鍵表生成の AI 自動化（RAG / LangChain / Weaviate）。", on: true },
  { period: "2024.04 – 2025.03", title: "日本アビオニクス株式会社 ／ 組み込みエンジニア", desc: "輸送機搭載無線機の改修設計（基本・詳細設計、C言語）。", on: false },
  { period: "2024.03", title: "帝京大学 理工学部 機械・精密システム工学科 卒業", desc: "", on: false },
];
---

<Base active="about" title="About | 佐藤 颯太郎 ポートフォリオ" description="AIエンジニア兼マーケター 佐藤颯太郎の自己紹介・強み・スキル・経歴。">
  {/* About */}
  <section>
    <div class="mx-auto max-w-5xl px-5 pb-16 pt-16 sm:pt-20">
      <p class="reveal kicker mb-2">About</p>
      <h1 class="reveal mb-10 font-display text-3xl font-bold text-ink sm:text-4xl">自己紹介</h1>
      <div class="grid gap-10 md:grid-cols-3">
        <div class="reveal space-y-4 text-[15px] leading-relaxed text-body md:col-span-2">
          <p>大学で機械・精密システム工学を学んだのち、防衛関連機器の組み込み設計（C言語）からキャリアをスタート。その後 Web システム開発へ転じ、社内システムの要件定義〜開発をチームリーダーとして担当しました。</p>
          <p>現在の主軸は <strong class="font-semibold text-ink">生成AI</strong> です。設計書からテスト打鍵表を生成する業務の RAG 自動化や、社内ナレッジ参照のための RAG プラットフォーム構築（プロジェクトリーダー）など、<strong class="font-semibold text-ink">LLM をプロダクションで動かす</strong>経験を積んできました。</p>
          <p>並行して、AIを活用したマーケター（SEO / AIO・MAツール運用・データ分析）としても活動。<strong class="font-semibold text-ink">「技術で作れる」だけでなく「ビジネス成果につなげる」</strong>ことを一貫して重視しています。日常的に Claude Code・Cursor 等を用いた AI 駆動開発（Vibe Coding）を実践しています。</p>
        </div>
        <div class="reveal delay-1 card-hover rounded-lg border border-line bg-soft p-5 text-sm">
          <p class="kicker mb-3">Profile</p>
          <ul class="space-y-2 text-body">
            <li class="flex justify-between gap-2"><span class="text-muted">氏名</span><span class="text-ink">佐藤 颯太郎</span></li>
            <li class="flex justify-between gap-2"><span class="text-muted">職種</span><span class="text-ink">AIエンジニア / マーケター</span></li>
            <li class="flex justify-between gap-2"><span class="text-muted">形態</span><span class="text-ink">個人事業主</span></li>
            <li class="flex justify-between gap-2"><span class="text-muted">学歴</span><span class="text-ink">帝京大学 理工学部</span></li>
          </ul>
          <p class="kicker mb-2 mt-5">Certification</p>
          <ul class="space-y-1 text-body">
            <li>G検定</li>
            <li>DeepLearning.AI TensorFlow Developer Professional</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Strengths */}
  <section class="border-t border-line bg-soft">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <p class="reveal kicker mb-2">Strengths</p>
      <h2 class="reveal mb-10 font-display text-2xl font-bold text-ink">大切にしている3つのこと</h2>
      <div class="grid gap-5 md:grid-cols-3">
        {strengths.map((s, i) => (
          <div class={`reveal card-hover rounded-lg border border-line bg-white p-6 delay-${i}`}>
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-md bg-brand-soft text-brand">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </div>
            <h3 class="mb-2 font-display font-bold text-ink">{s.title}</h3>
            <p class="text-sm leading-relaxed text-body">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Skills */}
  <section class="border-t border-line">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <p class="reveal kicker mb-2">Skills</p>
      <h2 class="reveal mb-10 font-display text-2xl font-bold text-ink">スキルセット</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {skills.map((s, i) => (
          <div class={`reveal card-hover rounded-lg border border-line bg-soft p-5 delay-${i % 3}`}>
            <h3 class="mb-3 font-display font-semibold text-ink">{s.cat}</h3>
            <ul class="space-y-1.5 text-sm text-body">{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="reveal mt-4 text-xs text-muted">※ 実務・個人開発で利用した主な技術。年数の詳細は職務経歴書をご参照ください。</p>
    </div>
  </section>

  {/* Career */}
  <section class="border-t border-line bg-soft">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <p class="reveal kicker mb-2">Career</p>
      <h2 class="reveal mb-10 font-display text-2xl font-bold text-ink">経歴</h2>
      <ol class="relative border-l border-line pl-6">
        {career.map((c, i) => (
          <li class={`reveal mb-8 last:mb-0 delay-${i % 3}`}>
            <span class={`absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full ${c.on ? "bg-brand" : "bg-slate-300"}`}></span>
            <p class="font-mono text-xs text-muted">{c.period}</p>
            <p class="mt-0.5 font-display font-semibold text-ink">{c.title}</p>
            {c.desc && <p class="mt-0.5 text-sm text-body">{c.desc}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-5xl px-5 py-12 text-center">
      <a href={`${base}contact/`} class="inline-block rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">お仕事のご相談はこちら →</a>
    </div>
  </section>
</Base>
