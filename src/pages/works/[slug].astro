---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const idx = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[idx - 1];
const next = projects[idx + 1];
---

<Base active="works" title={`${project.title} | 佐藤 颯太郎 ポートフォリオ`} description={project.subtitle}>
  <section>
    <div class="mx-auto max-w-5xl px-5 pb-6 pt-12 sm:pt-16">
      <a href={`${base}works/`} class="font-mono text-xs text-muted underline-offset-4 transition hover:text-ink hover:underline">← Works 一覧へ</a>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-5xl px-5 pb-10">
      <ProjectCard project={project} />
    </div>
  </section>

  {/* 前後ナビ */}
  <section class="border-t border-line">
    <div class="mx-auto flex max-w-5xl items-stretch justify-between gap-3 px-5 py-8">
      {prev ? (
        <a href={`${base}works/${prev.slug}/`} class="card-hover flex-1 rounded-lg border border-line bg-white p-4">
          <span class="font-mono text-[11px] text-muted">← Prev</span>
          <p class="mt-0.5 font-display text-sm font-semibold text-ink">{prev.title}</p>
        </a>
      ) : <span class="flex-1"></span>}
      {next ? (
        <a href={`${base}works/${next.slug}/`} class="card-hover flex-1 rounded-lg border border-line bg-white p-4 text-right">
          <span class="font-mono text-[11px] text-muted">Next →</span>
          <p class="mt-0.5 font-display text-sm font-semibold text-ink">{next.title}</p>
        </a>
      ) : <span class="flex-1"></span>}
    </div>
  </section>

  <section class="border-t border-line bg-soft">
    <div class="mx-auto max-w-5xl px-5 py-12 text-center">
      <a href={`${base}contact/`} class="inline-block rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">同様のご相談はこちら →</a>
    </div>
  </section>
</Base>
